{
  "name": "mcp-datos-argentina",
  "version": "0.1.0",
  "description": "Servidor MCP con datos públicos de Argentina: BCRA (variables, cotizaciones, Central de Deudores), dólar, inflación y feriados.",
  "type": "module",
  "bin": {
    "mcp-datos-argentina": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "argentina",
    "bcra",
    "dolar",
    "inflacion",
    "claude"
  ],
  "license": "MIT",
  "author": "Gonzalo Pedraza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gonza28fq/mcp-datos-argentina.git"
  },
  "homepage": "https://github.com/Gonza28fq/mcp-datos-argentina#readme",
  "bugs": "https://github.com/Gonza28fq/mcp-datos-argentina/issues",
  "mcpName": "io.github.Gonza28fq/mcp-datos-argentina",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
